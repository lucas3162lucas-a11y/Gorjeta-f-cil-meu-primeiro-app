# ===== Servidor =====
PORT=3000
# URL pública do seu servidor (usada nos links de checkout e no webhook)
PUBLIC_URL=https://seu-dominio.com.br
# Nome que aparece no site
APP_NAME=ZapVendas IA
# Texto aleatório e longo (proteção dos logins)
SESSION_SECRET=troque-isto-por-um-texto-grande-e-aleatorio

# ===== Administrador (você) =====
ADMIN_EMAIL=lucas3162lucas@gmail.com

# ===== IA NVIDIA (grátis em https://build.nvidia.com) =====
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelos usados por plano (pode trocar por qualquer modelo do catálogo NVIDIA)
NVIDIA_MODEL_SIMPLE=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_PLUS=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_PRO=nvidia/nemotron-3-ultra-550b-a55b
# Modelo reserva, se algum dos acima sair do ar
NVIDIA_MODEL_FALLBACK=openai/gpt-oss-20b

# ===== Pagamento: Cakto (assinatura mensal) =====
# Links de checkout de cada oferta (produto do tipo assinatura, recorrência mensal)
CAKTO_CHECKOUT_SIMPLE=https://pay.cakto.com.br/XXXXXXX
CAKTO_CHECKOUT_PLUS=https://pay.cakto.com.br/YYYYYYY
CAKTO_CHECKOUT_PRO=https://pay.cakto.com.br/ZZZZZZZ
# Secret do webhook (aparece ao criar o webhook na Cakto)
CAKTO_WEBHOOK_SECRET=cole-o-secret-aqui
# Dias de tolerância depois do vencimento antes de bloquear
GRACE_DAYS=2
